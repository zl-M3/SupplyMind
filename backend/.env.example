# ---------------------------------------------------------------------------
# SupplyMind 后端配置（复制为 .env 后按需修改；.env 已被 .gitignore 忽略）
# ---------------------------------------------------------------------------

# 基础信息
APP_NAME=SupplyMind
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1

# 数据库（MySQL 8）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=supplymind
DB_CHARSET=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
# 如需显式指定连接串则填写该项（优先级高于上面的分项配置）
# DATABASE_URL=mysql+pymysql://root:1234@127.0.0.1:3306/supplymind?charset=utf8mb4

# 认证
SECRET_KEY=supplymind-dev-secret-please-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 跨域（前端开发地址，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173

# LLM（留空则自动使用规则引擎兜底，三个 AI 场景依然可用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOOL_ROUNDS=6
LLM_TEMPERATURE=0.2

# 启动行为
AUTO_CREATE_TABLES=true
# 建议保持 false：true 时「空库」会被自动灌入 app/seed.py 的演示数据，
# 容易让人误以为页面数据「不是数据库里的那份」。需要时用 scripts/import_sql.py 显式导入。
AUTO_SEED_DEMO_DATA=false

# 业务规则
SUPPLIER_MIN_SAMPLE=3
DASHBOARD_TREND_DAYS=7

# Dify AI 助手（可选，默认关闭；启用时填你自己的 Dify 地址与 Key）
DIFY_ENABLED=false
DIFY_API_BASE=
DIFY_API_KEY=
DIFY_TIMEOUT_SECONDS=60
